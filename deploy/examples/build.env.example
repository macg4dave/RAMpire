# Example site file for tools/build.sh. Copy it to site/build.env
# (untracked). Only for building on a Linux host over SSH instead of in the
# build container.
# SSH destination of a Linux build host with Rust (and nfpm for packages).
RAMPIRE_BUILD_HOST=linux-build-host
# Absolute directory on that host that the build owns: src/ is replaced on
# every run and target/ keeps Cargo's output between runs.
RAMPIRE_BUILD_DIR=/var/tmp/rampire-build
# SSH client, if not the first ssh on PATH.
# RAMPIRE_SSH=/c/Windows/System32/OpenSSH/ssh.exe
