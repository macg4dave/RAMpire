{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Gate",
      "type": "shell",
      "command": "cargo",
      "args": [
        "xtask",
        "gate",
        "local"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [
        "$rustc"
      ]
    },
    {
      "label": "Live suite (rampire-test-* VMs on this host)",
      "type": "shell",
      "command": "cargo",
      "args": [
        "xtask",
        "live"
      ],
      "problemMatcher": []
    },
    {
      "label": "Packages",
      "type": "shell",
      "command": "tools/build.sh",
      "args": [
        "package"
      ],
      "problemMatcher": []
    }
  ]
}
